# Copy this file to .env.local and fill in your Supabase keys for local development
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side service role key (DO NOT commit the real key)
NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=
NEXT_PRIVATE_ADMIN_PASSWORD=
